# PeptoLogics — environment contract
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
# Never commit real values. The authoritative schema is src/lib/env.ts — if a
# variable is required there, the app will refuse to boot without it.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Drives metadataBase, canonical URLs and
# the same-origin check on POST /api/inquiries.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase  (Dashboard -> Project Settings -> API)
# ---------------------------------------------------------------------------
# REQUIRED. The app will not start without all three.
SUPABASE_URL=https://your-project-ref.supabase.co

# The `anon` / publishable key. Deliberately NOT prefixed NEXT_PUBLIC_ — the
# browser never talks to Supabase, so there is no reason to ship this key.
SUPABASE_ANON_KEY=

# The `service_role` / secret key. Bypasses RLS. Used only by the inquiry write
# path. If this ever appears in a client bundle, treat it as compromised and
# rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email — Resend  (https://resend.com/api-keys)
# ---------------------------------------------------------------------------
# OPTIONAL. With these absent, inquiries still save successfully and the email
# channel records `skipped` in notification_log. Nothing throws.
RESEND_API_KEY=

# Must be an address on a Resend-verified sending domain (needs SPF + DKIM DNS
# records). Format: "PeptoLogics <inquiries@peptologics.com>"
INQUIRY_NOTIFICATION_FROM=

# Who receives inquiry notifications. Comma-separated for multiple recipients.
INQUIRY_NOTIFICATION_TO=

# ---------------------------------------------------------------------------
# WhatsApp — Meta Cloud API
# ---------------------------------------------------------------------------
# OPTIONAL and off by default. Server-side sending requires: a Meta Business
# Account with Business Verification completed, a WhatsApp Business Account, a
# registered phone number, a System User permanent access token, and an APPROVED
# message template. A plain text send will be rejected, because the recipient
# (your own number) never opens the 24-hour customer service window.
#
# Until all of that exists, leave WHATSAPP_ENABLED=false. The success page still
# offers a wa.me deep link, which needs only NEXT_PUBLIC_WHATSAPP_NUMBER below.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# E.164 without the leading '+', e.g. 15551234567
WHATSAPP_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LOCALE=en

# ---------------------------------------------------------------------------
# Public contact details  (shown in the footer — public by nature)
# ---------------------------------------------------------------------------
# E.164 without the leading '+'. Powers the wa.me deep links.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Bearer secret for POST /api/revalidate, which purges the catalog cache after a
# price change. Minimum 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_SECRET=

# Salt used to hash IP addresses before they reach the rate-limit table, so no
# raw address is ever stored. Minimum 16 characters. Generate as above.
# Changing this resets all active rate-limit windows.
RATE_LIMIT_SALT=
