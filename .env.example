# PeptoLogics — environment contract
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
# Never commit real values. The authoritative schema is src/lib/env.ts — if a
# variable is required there, the app will refuse to boot without it.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Drives metadataBase, canonical URLs, the
# sitemap, robots.txt, the JSON-LD @ids and the same-origin check on
# POST /api/inquiries.
#
# In a Vercel production deployment this MUST be the real customer-facing domain,
# and it must match whichever host is primary in Vercel's Domains panel. A
# *.vercel.app value or localhost fails the build (ADR-025) — pointed at the
# deployment URL, every canonical names a host that is not the one being served.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase  (Dashboard -> Project Settings -> API)
# ---------------------------------------------------------------------------
# REQUIRED. The app will not start without all three.
SUPABASE_URL=https://your-project-ref.supabase.co

# The `anon` / publishable key. Deliberately NOT prefixed NEXT_PUBLIC_ — the
# browser never talks to Supabase, so there is no reason to ship this key.
SUPABASE_ANON_KEY=

# The `service_role` / secret key. Bypasses RLS. Used only by the inquiry write
# path. If this ever appears in a client bundle, treat it as compromised and
# rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email — Resend  (https://resend.com/api-keys)
# ---------------------------------------------------------------------------
# OPTIONAL. With these absent, inquiries still save successfully and both email
# channels record `skipped` in notification_log. Nothing throws.
RESEND_API_KEY=

# Must be an address on a Resend-verified sending domain (needs SPF + DKIM DNS
# records). Format: "PeptoLogics <inquiries@peptologics.com>"
INQUIRY_NOTIFICATION_FROM=

# Who receives inquiry notifications. Comma-separated for multiple recipients.
# The first address here is also the reply-to on the customer confirmation, and is
# named in its body as a second route back to a human.
INQUIRY_NOTIFICATION_TO=

# Sender for the confirmation email the customer receives (ADR-027). Falls back to
# INQUIRY_NOTIFICATION_FROM when unset, so confirmations are never skipped for want
# of this variable alone.
#
# Set it to an address a customer would recognise and can reply to — this message is
# their only written record of the exchange. Format as above:
#   "PeptoLogics <hello@peptologics.com>"
#
# It must be on a Resend-verified domain like any other sender. Resend's shared
# `onboarding@resend.dev` test sender will NOT work here: it can only deliver to the
# Resend account owner's own address, so every real customer send fails with a 403.
CUSTOMER_CONFIRMATION_FROM=

# ---------------------------------------------------------------------------
# Public contact details  (shown in the footer — public by nature)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Bearer secret for POST /api/revalidate, which purges the catalog cache after a
# price change. Minimum 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_SECRET=

# Salt used to hash IP addresses before they reach the rate-limit table, so no
# raw address is ever stored. Minimum 16 characters. Generate as above.
# Changing this resets all active rate-limit windows.
RATE_LIMIT_SALT=
