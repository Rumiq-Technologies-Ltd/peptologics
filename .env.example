# PeptoLogics — environment contract
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
# Never commit real values. The authoritative schema is src/lib/env.ts — if a
# variable is required there, the app will refuse to boot without it.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Drives metadataBase, canonical URLs, the
# sitemap, robots.txt, the JSON-LD @ids and the same-origin check on
# POST /api/inquiries.
#
# In the production deployment (APP_ENV=production) this MUST be the real
# customer-facing domain. An *.amplifyapp.com value or localhost fails the build
# (ADR-025) — pointed at the deployment URL, every canonical names a host that is
# not the one being served.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Deployment environment
# ---------------------------------------------------------------------------
# Which deployment this is: development | staging | production. We set it per
# Amplify branch (main=production, staging=staging); leave it blank on a developer
# machine. Only "production" opens robots.txt to crawlers and turns on the build-time
# site-URL and email checks (ADR-032). NODE_ENV cannot make this distinction.
APP_ENV=

# ---------------------------------------------------------------------------
# Data store: Supabase or DynamoDB  (ADR-035)
# ---------------------------------------------------------------------------
# Which database holds products, inquiries, notifications and rate limits:
# "supabase" or "dynamodb". Unset means "supabase", so shipping the DynamoDB code
# changes nothing. Switching (or rolling back) is changing this and rebuilding.
INQUIRY_DATA_STORE=

# DynamoDB only. REQUIRED when INQUIRY_DATA_STORE=dynamodb. One table per
# environment: peptologics-dev (developer machines only), peptologics-staging,
# peptologics-prod. NEVER point a local machine at peptologics-prod.
# AWS credentials are never set here: locally use AWS_PROFILE=peptologics-dev
# (in ~/.aws/config); on Amplify the app's IAM role supplies them. Amplify
# rejects variable names starting with AWS_, so there is no region variable
# either: the region is a constant (us-east-1).
DYNAMODB_TABLE_NAME=

# ---------------------------------------------------------------------------
# Supabase  (Dashboard -> Project Settings -> API)
# ---------------------------------------------------------------------------
# REQUIRED while INQUIRY_DATA_STORE is "supabase" (the default). Ignored once the
# store is "dynamodb". Retired after the two-week fallback period (D7).
SUPABASE_URL=https://your-project-ref.supabase.co

# The `anon` / publishable key. Deliberately NOT prefixed NEXT_PUBLIC_ — the
# browser never talks to Supabase, so there is no reason to ship this key.
SUPABASE_ANON_KEY=

# The `service_role` / secret key. Bypasses RLS. Used only by the inquiry write
# path (and by scripts/migrate-supabase-to-dynamodb.ts). If this ever appears in a
# client bundle, treat it as compromised and rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email — Resend or Amazon SES  (ADR-037)
# ---------------------------------------------------------------------------
# OPTIONAL. With the provider's credentials absent, inquiries still save and both
# email channels record `skipped` in notification_log. Nothing throws.

# Which provider sends email: "resend" or "ses". Unset means "resend".
# Switching (or rolling back) is changing this and rebuilding.
INQUIRY_EMAIL_PROVIDER=

# SES only. The configuration set every send is tagged with (bounce and complaint
# tracking). Required in production when the provider is "ses": "peptologics-prod".
# AWS credentials are never set here: locally use AWS_PROFILE=peptologics-dev,
# on Amplify the app's IAM role supplies them.
INQUIRY_SES_CONFIGURATION_SET=

# Resend only (https://resend.com/api-keys). Needed while the provider is "resend".
RESEND_API_KEY=

# Must be an address on a domain verified with the active provider (SPF + DKIM).
# Format: "PeptoLogics <inquiries@peptologics.com>"
INQUIRY_NOTIFICATION_FROM=

# Who receives inquiry notifications. Comma-separated for multiple recipients.
# The first address here is also the reply-to on the customer confirmation, and is
# named in its body as a second route back to a human.
INQUIRY_NOTIFICATION_TO=

# Sender for the confirmation email the customer receives (ADR-027). Falls back to
# INQUIRY_NOTIFICATION_FROM when unset, so confirmations are never skipped for want
# of this variable alone.
#
# Set it to an address a customer would recognise and can reply to — this message is
# their only written record of the exchange. Format as above:
#   "PeptoLogics <hello@peptologics.com>"
#
# It must be on a verified domain like any other sender. Resend's shared
# `onboarding@resend.dev` test sender will NOT work here: it can only deliver to the
# Resend account owner's own address, so every real customer send fails with a 403.
CUSTOMER_CONFIRMATION_FROM=

# ---------------------------------------------------------------------------
# Public contact details  (shown in the footer — public by nature)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Admin sign-in: Amazon Cognito  (ADR-038)
# ---------------------------------------------------------------------------
# OPTIONAL. None of these is a secret (the app client is public: PKCE, no client
# secret). Set all three or none. The admin at /admin is ON only when all three are
# set AND INQUIRY_DATA_STORE=dynamodb AND APP_ENV is not "production"; otherwise
# /admin is a 404. The pool is created by the control chat (staging pool today).
# Locally the sign-in callback is http://localhost:3000/api/auth/sign-in-callback.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Managed-login hostname only, no https://, e.g. <prefix>.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Bearer secret for POST /api/revalidate, which purges the catalog cache after a
# price change. Minimum 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_SECRET=

# Salt used to hash IP addresses before they reach the rate-limit table, so no
# raw address is ever stored. Minimum 16 characters. Generate as above.
# Changing this resets all active rate-limit windows.
RATE_LIMIT_SALT=
